# SDIT SmartBot Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,*

# Optional: Google Gemini API Key for generative RAG responses
# If left blank, the backend runs 100% offline using intelligent local retrieval
GEMINI_API_KEY=

# Model Name (if Gemini API key is provided)
MODEL_NAME=gemini-1.5-flash

# Minimum similarity threshold for retrieval (0.0 to 1.0)
MIN_SIMILARITY_SCORE=0.15
TOP_K_DOCUMENTS=3
